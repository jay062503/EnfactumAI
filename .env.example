# =====================================================================
# Enfactum AI Assistant configuration
# Copy this file to `.env` (same folder) and fill it in. Never commit .env.
# The server reads ONLY `.env` - editing .env.example has no effect.
# =====================================================================

APP_NAME="Enfactum AI Assistant"
HOST=0.0.0.0
PORT=8080
# development | production  (production refuses AUTH_MODE=demo)
ENVIRONMENT=development
# Comma-separated origins allowed to call / embed the assistant (the Enfactum OS frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
DATA_DIR=./data

# ---------------------------------------------------------------------
# LLM - any OpenAI-compatible provider. Only LLM_API_KEY is required:
# the provider is detected from the key prefix and sensible defaults are used.
#   sk-...      OpenAI            AIza...   Google Gemini
#   gsk_...     Groq              sk-or-... OpenRouter
#   sk-ant-...  Anthropic         xai-...   xAI
# Or set LLM_PROVIDER explicitly: openai | gemini | groq | openrouter | anthropic |
#   mistral | deepseek | xai | ollama | custom (with LLM_BASE_URL)
# No quotes needed around values. The model MUST support tool/function calling.
# ---------------------------------------------------------------------
LLM_PROVIDER=auto
LLM_API_KEY=
# Leave empty for the provider default (openai: gpt-4o-mini, gemini: gemini-2.0-flash, ...)
LLM_MODEL=
# Leave empty to use the provider's standard endpoint
LLM_BASE_URL=
# Context window shown in the UI meter and used to trim history (0 = provider default)
LLM_CONTEXT_WINDOW=0
# Set false if the model cannot read images
LLM_SUPPORTS_VISION=true
LLM_TEMPERATURE=0.2
# Upper bound only (does not slow short answers); must fit full documents written by create_file
LLM_MAX_TOKENS=4096
# Max wait between streamed chunks before failing fast; one retry
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# SPEED: "thinking" models (gemini-2.5-*, o3/o4, gpt-5*) spend seconds reasoning before answering.
# For sub-5-second answers use a fast non-reasoning model (gpt-4o-mini, gpt-4.1-mini, gemini-2.0-flash,
# llama-3.3-70b on Groq) or set LLM_REASONING_EFFORT=low (or minimal / none where the provider supports it).
LLM_REASONING_EFFORT=

# ---------------------------------------------------------------------
# Reading text from images and scanned PDFs (OCR)
#   auto      -> the vision model above if LLM_SUPPORTS_VISION=true, else Tesseract if installed
#   llm       -> vision model (OCR_MODEL / OCR_BASE_URL / OCR_API_KEY can point to another model)
#   tesseract -> local, offline (install the `tesseract` binary + pip install pytesseract Pillow)
#   none      -> disabled
# ---------------------------------------------------------------------
OCR_PROVIDER=auto
OCR_MODEL=
OCR_BASE_URL=
OCR_API_KEY=
OCR_MAX_PAGES=30

# ---------------------------------------------------------------------
# Creating files (PDF, Word, PowerPoint, Excel, CSV, TXT, MD, HTML, JSON), charts and images
#   IMAGE_GENERATION: auto (on when the LLM key is an OpenAI key or IMAGE_API_KEY is set) | on | off
# ---------------------------------------------------------------------
FILE_GENERATION_ENABLED=true
IMAGE_GENERATION=auto
IMAGE_MODEL=gpt-image-1
IMAGE_BASE_URL=
IMAGE_API_KEY=

# ---------------------------------------------------------------------
# Agentic actions: write operations declared under `actions:` in OS_TOOLS_FILE.
# The assistant only PREPARES them; the employee must click Confirm, then the OS executes them
# with the employee's own token. Confirmation cards expire after ACTION_EXPIRY_MINUTES.
# ---------------------------------------------------------------------
AI_ACTIONS_ENABLED=true
ACTION_EXPIRY_MINUTES=15

# ---------------------------------------------------------------------
# Embeddings for company-document search
#   llm   -> the LLM provider's embeddings API (OpenAI, Gemini, Mistral, Ollama)
#   local -> fastembed on CPU, no API needed (pip install -r requirements-optional.txt)
#   none  -> keyword (BM25) search only
# Providers without an embeddings API automatically fall back to keyword search.
# ---------------------------------------------------------------------
EMBEDDING_PROVIDER=llm
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------
# Web search for public / current information
#   auto -> Tavily if TAVILY_API_KEY set, otherwise DuckDuckGo (no key)
#   none -> disable web search
# ---------------------------------------------------------------------
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
# Full pages fetched for DuckDuckGo results (0 = snippets only, fastest). Tavily needs none.
WEB_FETCH_PAGES=1
WEB_TIMEOUT_SECONDS=6

# ---------------------------------------------------------------------
# Authentication
#   demo    -> one local test employee from config/demo_users.yaml (NEVER in production)
#   laravel -> validate the caller's Enfactum OS token/cookies via OS_USER_ENDPOINT
#   jwt     -> verify a JWT issued by Enfactum OS
# ---------------------------------------------------------------------
AUTH_MODE=demo
DEMO_USERS_FILE=config/demo_users.yaml

OS_BASE_URL=http://127.0.0.1:8080/mock-os
OS_USER_ENDPOINT=/api/user
OS_USER_ID_FIELD=id
OS_USER_NAME_FIELD=name
OS_USER_EMAIL_FIELD=email
OS_USER_ROLES_FIELD=roles
OS_USER_PERMISSIONS_FIELD=permissions
# Enfactum OS has two account types. Only these may open the assistant (clients get "employees only").
# The type is read from OS_USER_TYPE_FIELD; if absent, users whose roles are all in CLIENT_ROLES are clients.
OS_USER_TYPE_FIELD=user_type
ALLOWED_USER_TYPES=employee
CLIENT_ROLES=client
OS_FORWARD_COOKIES=false
OS_VERIFY_SSL=true
AUTH_CACHE_SECONDS=60

JWT_SECRET=
JWT_PUBLIC_KEY_FILE=
JWT_ALGORITHMS=HS256
JWT_AUDIENCE=
JWT_ISSUER=

# ---------------------------------------------------------------------
# Live company data
#   OS API tools (recommended): read-only Enfactum OS endpoints, called with the user's own token
#   DB tools (optional): admin-written SQL templates over a READ-ONLY database role
# ---------------------------------------------------------------------
OS_TOOLS_FILE=config/os_tools.demo.yaml
MOCK_OS_ENABLED=true
SEED_SAMPLE_DOCS=true

# postgresql://ai_readonly:***@db-host:5432/enfactum   (needs: pip install "psycopg[binary]")
COMPANY_DB_DSN=
DB_TOOLS_FILE=config/db_tools.yaml
DB_STATEMENT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------
# Authorization for assistant features (empty = any authenticated employee)
# ---------------------------------------------------------------------
ADMIN_ROLES=super_admin,admin
PERM_CHAT=
PERM_WEB_SEARCH=
PERM_DOCUMENTS_MANAGE=ai.documents.manage

# ---------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
MAX_UPLOAD_MB=25
MAX_ATTACHMENT_MB=20
ATTACHMENT_CONTEXT_CHARS=48000
MAX_TOOL_ROUNDS=4
# Per-tool time budget (search, OS API, DB). File/image creation has its own longer budget.
TOOL_TIMEOUT_SECONDS=12
HISTORY_TURNS=12
RATE_LIMIT_PER_MINUTE=30
